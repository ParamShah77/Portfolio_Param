# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# Server-side Gemini key, used only by the Vercel serverless proxy (api/chat.js).
# No VITE_ prefix: that would inline it into the client bundle.
# In production, set this in the Vercel dashboard under
# Settings > Environment Variables (not in a file).
GEMINI_API_KEY=your-key-here

# Optional. Comma-separated list of origins allowed to call /api/chat.
# Defaults to the production domain plus localhost when unset.
# ALLOWED_ORIGINS=https://paramshahportfolio.vercel.app,http://localhost:5173
